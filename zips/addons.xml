<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
    <addon id="repository.repodawg" version="1.0.26" name="RepoDawg Repository" provider-name="Dawg">
        <requires>
            <import addon="xbmc.addon" version="17.0"/>
        </requires>
        <extension point="xbmc.addon.repository" name="RepoDawg Repository">
            <info compressed="false">https://jason247g.github.io/RepoDawg/zips/addons.xml</info>
            <checksum>https://jason247g.github.io/RepoDawg/zips/addons.xml.md5</checksum>
            <datadir zip="true">https://jason247g.github.io/RepoDawg/zips/</datadir>
        </extension>
        <extension point="xbmc.addon.metadata">
            <summary lang="en">RepoDawg Repository</summary>
            <description lang="en">RepoDawg Repository for Dawg Wizard and builds</description>
            <platform>all</platform>
        </extension>
    </addon>
    <addon id="plugin.program.dawgwizard" version="4.21" name="Dawg Wizard" provider-name="Dawg">
        <requires>
            <import addon="xbmc.python" version="3.0.0"/>
        </requires>
        <extension point="xbmc.python.pluginsource" library="addon.py">
            <provides>executable</provides>
        </extension>
        <extension point="xbmc.addon.metadata">
            <summary lang="en_GB">Dawg Wizard for updating Dawg build in Kodi</summary>
            <description lang="en_GB">Dawg Wizard</description>
            <platform>all</platform>
        </extension>
    </addon>
</addons>